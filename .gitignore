# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment & secrets
.env
.env.*
*.key

# Data (regenerable: DB, caches, raw downloads)
data/db/
data/cache/
data/raw/
*.db
*.sqlite3

# Logs
logs/

# Trained models.
# Model artifacts are committed through Git LFS (see .gitattributes) so that a
# Vercel build contains real predictors instead of falling back to heuristics.
# Everything else under models/trained stays ignored; metadata JSON is tracked
# as a normal file. The directory itself must not be excluded wholesale, or git
# would refuse the `!` negations below ("cannot re-include under an excluded
# directory"), hence `models/trained/*` rather than `models/trained/`.
models/trained/*
!models/trained/metadata/
!models/trained/*.joblib
!models/trained/*.ubj
*.joblib
*.ubj
*.json.xz

# Node / frontend
node_modules/
frontend/dist/
*.local

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
